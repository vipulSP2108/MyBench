{
  "question_id": "q_078_updated_status",
  "slug": "updated-status",
  "title": "Advertiser Status",
  "difficulty": "Hard",
  "company": "Facebook",
  "premium": false,
  "question": "Meta advertiser billing operations tracks how advertisers' payment status changes day to day.\n\n`advertiser` holds each known advertiser's current `status` (`'NEW'`, `'EXISTING'`, `'CHURN'` or `'RESURRECT'`). `daily_pay` has one row for every advertiser that paid today, including advertisers not yet in `advertiser`. The statuses update as follows:\n\n• Advertiser **not** in `advertiser` who paid today → `'NEW'`.\n• Known advertiser who paid today → `'EXISTING'`, or `'RESURRECT'` if their current status is `'CHURN'`.\n• Known advertiser who did **not** pay today → `'CHURN'`.\n\nWrite a query to output each advertiser's `user_id` and updated status (`new_status`), ordered by `user_id`.",
  "notes": [
    "'bing' is a known advertiser with no payment in `daily_pay`, so it becomes CHURN.",
    "'yahoo' and 'alibaba' are known advertisers who paid, so they stay EXISTING (a CHURN advertiser who pays again becomes RESURRECT).",
    "'target' paid but is not yet in `advertiser`, so it is NEW."
  ],
  "tables": [
    {
      "table_name": "advertiser",
      "columns": [
        {
          "column_name": "user_id",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "status",
          "data_type": "VARCHAR(255)"
        }
      ]
    },
    {
      "table_name": "daily_pay",
      "columns": [
        {
          "column_name": "user_id",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "paid",
          "data_type": "DECIMAL(10,2)"
        }
      ]
    }
  ],
  "sample_data": {
    "advertiser": [
      {
        "user_id": "bing",
        "status": "NEW"
      },
      {
        "user_id": "yahoo",
        "status": "NEW"
      },
      {
        "user_id": "alibaba",
        "status": "EXISTING"
      }
    ],
    "daily_pay": [
      {
        "user_id": "yahoo",
        "paid": "45.00"
      },
      {
        "user_id": "alibaba",
        "paid": "100.00"
      },
      {
        "user_id": "target",
        "paid": "13.00"
      }
    ]
  },
  "sample_output": [
    {
      "user_id": "alibaba",
      "new_status": "EXISTING"
    },
    {
      "user_id": "bing",
      "new_status": "CHURN"
    },
    {
      "user_id": "target",
      "new_status": "NEW"
    },
    {
      "user_id": "yahoo",
      "new_status": "EXISTING"
    }
  ],
  "reference_sql": "SELECT a.user_id,\n       CASE WHEN d.user_id IS NULL THEN 'CHURN'\n            WHEN a.status = 'CHURN' THEN 'RESURRECT'\n            ELSE 'EXISTING' END AS new_status\nFROM advertiser a\nLEFT JOIN daily_pay d ON a.user_id = d.user_id\nUNION ALL\nSELECT d.user_id, 'NEW' AS new_status\nFROM daily_pay d\nLEFT JOIN advertiser a ON a.user_id = d.user_id\nWHERE a.user_id IS NULL\nORDER BY user_id;",
  "tags": [
    "date-manipulation",
    "facebook",
    "finance",
    "hard",
    "social-media"
  ],
