{
  "question_id": "q_058_card_launch_success",
  "slug": "card-launch-success",
  "title": "Card Launch Success",
  "difficulty": "Medium",
  "company": "JPMorgan",
  "premium": false,
  "question": "JPMorgan Chase regularly introduces new credit card products to the consumer market. Product executives want to evaluate initial launch adoption.\n\nWrite a query to find the number of credit cards issued during the **first launch month** for each credit card brand.\n\nOutput the `card_name` and the number of cards issued in its launch month (named `issued_amount`). Sort the results by `issued_amount` in descending order.",
  "notes": [
    "Chase Sapphire Reserve card was launched on 1/2021 with an issued amount of 170,000 cards and the Chase Freedom Flex card was launched on 3/2021 with an issued amount of 65,000 cards.",
    "Hint: Try using a window function 👀"
  ],
  "tables": [
    {
      "table_name": "monthly_cards_issued",
      "columns": [
        {
          "column_name": "issue_month",
          "data_type": "INT"
        },
        {
          "column_name": "issue_year",
          "data_type": "INT"
        },
        {
          "column_name": "card_name",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "issued_amount",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "monthly_cards_issued": [
      {
        "issue_month": "1",
        "issue_year": "2021",
        "card_name": "Chase Sapphire Reserve",
        "issued_amount": "170000"
      },
      {
        "issue_month": "2",
        "issue_year": "2021",
        "card_name": "Chase Sapphire Reserve",
        "issued_amount": "175000"
      },
      {
        "issue_month": "3",
        "issue_year": "2021",
        "card_name": "Chase Sapphire Reserve",
        "issued_amount": "180000"
      },
      {
        "issue_month": "3",
        "issue_year": "2021",
        "card_name": "Chase Freedom Flex",
        "issued_amount": "65000"
      },
      {
        "issue_month": "4",
        "issue_year": "2021",
        "card_name": "Chase Freedom Flex",
        "issued_amount": "70000"
      }
    ]
  },
  "sample_output": [
    {
      "card_name": "Chase Sapphire Reserve",
      "issued_amount": "170000"
    },
    {
      "card_name": "Chase Freedom Flex",
      "issued_amount": "65000"
    }
  ],
  "reference_sql": "WITH launch_dates AS (\n  SELECT card_name, issue_year, issue_month, issued_amount,\n         ROW_NUMBER() OVER (PARTITION BY card_name ORDER BY issue_year, issue_month) AS rn\n  FROM monthly_cards_issued\n)\nSELECT card_name, issued_amount\nFROM launch_dates\nWHERE rn = 1\nORDER BY issued_amount DESC, card_name ASC;",
  "tags": [
    "date-manipulation",
    "ecommerce",
    "healthcare",
    "jpmorgan",
    "medium"
  ],
