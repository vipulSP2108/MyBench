{
  "question_id": "q_062_money_transfer_relationships",
  "slug": "money-transfer-relationships",
  "title": "Unique Money Transfer Relationships",
  "difficulty": "Medium",
  "company": "PayPal",
  "premium": true,
  "question": "PayPal risk management algorithms monitor peer-to-peer (P2P) money transfer relationships to prevent payment fraud.\n\nA **two-way relationship** exists between two users if User A has sent money to User B, and User B has also sent money back to User A.\n\nWrite a query to count how many distinct two-way payment relationships exist across the user base. Output the count as `relationships`.",
  "notes": [
    "A pair of users counts once, no matter how many payments went each way."
  ],
  "tables": [
    {
      "table_name": "payments",
      "columns": [
        {
          "column_name": "payer_id",
          "data_type": "INT"
        },
        {
          "column_name": "recipient_id",
          "data_type": "INT"
        },
        {
          "column_name": "amount",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "payments": [
      {
        "payer_id": 101,
        "recipient_id": 201,
        "amount": 30
      },
      {
        "payer_id": 201,
        "recipient_id": 101,
        "amount": 10
      },
      {
        "payer_id": 101,
        "recipient_id": 301,
        "amount": 20
      },
      {
        "payer_id": 301,
        "recipient_id": 101,
        "amount": 80
      },
      {
        "payer_id": 201,
        "recipient_id": 301,
        "amount": 70
      }
    ]
  },
  "sample_output": [
    {
      "relationships": 2
    }
  ],
  "reference_sql": "SELECT COUNT(*) AS relationships\nFROM (SELECT DISTINCT payer_id, recipient_id FROM payments) p1\nJOIN (SELECT DISTINCT payer_id, recipient_id FROM payments) p2\n  ON p1.payer_id = p2.recipient_id AND p1.recipient_id = p2.payer_id\nWHERE p1.payer_id < p1.recipient_id;",
  "tags": [
    "finance",
    "medium",
    "paypal"
  ],
