{
  "question_id": "q_089_concurrent_user_sessions",
  "slug": "concurrent-user-sessions",
  "title": "User Concurrent Sessions",
  "difficulty": "Hard",
  "company": "Pinterest",
  "premium": true,
  "question": "Platform reliability engineers need to monitor peak server demand by finding the maximum number of user sessions that were active at the exact same moment.\n\nA session is active from its `start_time` up to, but not including, its `end_time`. A session that ends at the exact moment another one starts does **not** overlap with it.\n\nWrite a query to calculate the maximum number of concurrent sessions at any point in time. Output it as `max_concurrent_sessions`.",
  "notes": [],
  "tables": [
    {
      "table_name": "user_sessions",
      "columns": [
        {
          "column_name": "session_id",
          "data_type": "INT"
        },
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "start_time",
          "data_type": "DATETIME"
        },
        {
          "column_name": "end_time",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
    "user_sessions": [
      {
        "session_id": 1,
        "user_id": 101,
        "start_time": "2022-01-01 10:00:00",
        "end_time": "2022-01-01 12:00:00"
      },
      {
        "session_id": 2,
        "user_id": 102,
        "start_time": "2022-01-01 10:30:00",
        "end_time": "2022-01-01 14:00:00"
      },
      {
        "session_id": 3,
        "user_id": 103,
        "start_time": "2022-01-01 11:00:00",
        "end_time": "2022-01-01 13:00:00"
      },
      {
        "session_id": 4,
        "user_id": 104,
        "start_time": "2022-01-01 13:30:00",
        "end_time": "2022-01-01 15:00:00"
      }
    ]
  },
  "sample_output": [
    {
      "max_concurrent_sessions": 3
    }
  ],
  "reference_sql": "WITH events AS (\n  SELECT start_time AS t, 1 AS delta FROM user_sessions\n  UNION ALL\n  SELECT end_time AS t, -1 AS delta FROM user_sessions\n),\nrunning AS (\n  SELECT SUM(delta) OVER (ORDER BY t, delta ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS concurrent\n  FROM events\n)\nSELECT MAX(concurrent) AS max_concurrent_sessions\nFROM running;",
  "tags": [
    "aggregation",
    "hard",
    "join",
    "left-join",
    "pinterest"
  ],
