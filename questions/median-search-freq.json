{
  "question_id": "q_077_median_search_freq",
  "slug": "median-search-freq",
  "title": "Median Google Search Frequency",
  "difficulty": "Hard",
  "company": "Google",
  "premium": false,
  "question": "Google Search query infrastructure tracks search volume distribution across millions of daily active users.\n\nIn the frequency table `search_category`, the data is summarized by:\n• `searches`: The number of search queries performed.\n• `num_users`: The number of users who performed that exact number of searches.\n\nWrite a query to calculate the **median number of searches per user**. Round the median to 1 decimal place.",
  "notes": [
    "By expanding the search_frequency table, we get [1, 1, 2, 2, 3, 3, 3, 4] which has a median of 2.5 searches per user."
  ],
  "tables": [
    {
      "table_name": "search_frequency",
      "columns": [
        {
          "column_name": "searches",
          "data_type": "INT"
        },
        {
          "column_name": "num_users",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "search_frequency": [
      {
        "searches": "1",
        "num_users": "2"
      },
      {
        "searches": "2",
        "num_users": "2"
      },
      {
        "searches": "3",
        "num_users": "3"
      },
      {
        "searches": "4",
        "num_users": "1"
      }
    ]
  },
  "sample_output": [
    {
      "median": "2.5"
    }
  ],
  "reference_sql": "WITH expanded AS (\n  SELECT searches, num_users,\n         SUM(num_users) OVER (ORDER BY searches) AS cum_users,\n         SUM(num_users) OVER () AS total_users\n  FROM search_frequency\n)\nSELECT ROUND(AVG(searches), 1) AS median\nFROM expanded\nWHERE cum_users >= total_users / 2.0\nLIMIT 1;",
  "tags": [
    "date-manipulation",
    "google",
    "hard",
    "math"
  ],
