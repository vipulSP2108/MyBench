{
  "question_id": "q_094_matching_rental_amenities",
  "slug": "matching-rental-amenities",
  "title": "Matching Rental Amenities",
  "difficulty": "Hard",
  "company": "Airbnb",
  "premium": true,
  "question": "Airbnb search ranking engineers want to measure property similarity based on shared amenities.\n\nWrite a query to find all pairs of rental listings that share at least one amenity. Display `rental_1`, `rental_2`, and the count of matching amenities as `matching_amenities`.\n\nEnsure `rental_1 < rental_2` so each pair is output only once. Sort the results in descending order of matching amenities, breaking ties by `rental_1` and `rental_2` in ascending order.",
  "notes": [],
  "tables": [
    {
      "table_name": "rental_amenities",
      "columns": [
        {
          "column_name": "rental_id",
          "data_type": "INT"
        },
        {
          "column_name": "amenity",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "rental_amenities": [
      {
        "rental_id": 1,
        "amenity": "kitchen"
      },
      {
        "rental_id": 1,
        "amenity": "pool"
      },
      {
        "rental_id": 2,
        "amenity": "pool"
      },
      {
        "rental_id": 2,
        "amenity": "kitchen"
      },
      {
        "rental_id": 3,
        "amenity": "kitchen"
      },
      {
        "rental_id": 3,
        "amenity": "pool"
      },
      {
        "rental_id": 3,
        "amenity": "fireplace"
      },
      {
        "rental_id": 4,
        "amenity": "pool"
      },
      {
        "rental_id": 4,
        "amenity": "fireplace"
      }
    ]
  },
  "sample_output": [
    {
      "matching_airbnb": 1
    }
  ],
  "reference_sql": "SELECT a.rental_id AS rental_1, b.rental_id AS rental_2, COUNT(a.amenity) AS matching_amenities\nFROM rental_amenities a\nJOIN rental_amenities b ON a.amenity = b.amenity AND a.rental_id < b.rental_id\nGROUP BY a.rental_id, b.rental_id\nHAVING COUNT(a.amenity) >= 2\nORDER BY matching_amenities DESC, rental_1, rental_2;",
  "tags": [
    "aggregation",
    "airbnb",
    "cte",
    "hard",
    "join"
  ],
  "related_questions": [],
