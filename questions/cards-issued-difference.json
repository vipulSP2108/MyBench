{
  "question_id": "q_017_cards_issued_difference",
  "slug": "cards-issued-difference",
  "title": "Cards Issued Difference",
  "difficulty": "Easy",
  "company": "JPMorgan",
  "premium": false,
  "question": "JPMorgan Chase credit risk analysts are reviewing monthly issuance volatility across credit card portfolios.\n\nFor each credit card, calculate the difference between the maximum number of cards issued in any single month and the minimum number of cards issued in any single month.\n\nWrite a query to output the `card_name` and the calculated issuance difference (named `difference`). Sort the results by `difference` in descending order.",
  "notes": [
    "Chase Freedom Flex's best month was 70k cards issued and the worst month was 55k cards, so the difference is 15k cards.",
    "Chase Sapphire Reserve’s best month was 180k cards issued and the worst month was 170k cards, so the difference is 10k cards."
  ],
  "tables": [
    {
      "table_name": "monthly_cards_issued",
      "columns": [
        {
          "column_name": "card_name",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "issued_amount",
          "data_type": "INT"
        },
        {
          "column_name": "issue_month",
          "data_type": "INT"
        },
        {
          "column_name": "issue_year",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "monthly_cards_issued": [
      {
        "card_name": "Chase Freedom Flex",
        "issued_amount": "55000",
        "issue_month": "1",
        "issue_year": "2021"
      },
      {
        "card_name": "Chase Freedom Flex",
        "issued_amount": "60000",
        "issue_month": "2",
        "issue_year": "2021"
      },
      {
        "card_name": "Chase Freedom Flex",
        "issued_amount": "65000",
        "issue_month": "3",
        "issue_year": "2021"
      },
      {
        "card_name": "Chase Freedom Flex",
        "issued_amount": "70000",
        "issue_month": "4",
        "issue_year": "2021"
      },
      {
        "card_name": "Chase Sapphire Reserve",
        "issued_amount": "170000",
        "issue_month": "1",
        "issue_year": "2021"
      },
      {
        "card_name": "Chase Sapphire Reserve",
        "issued_amount": "175000",
        "issue_month": "2",
        "issue_year": "2021"
      },
      {
        "card_name": "Chase Sapphire Reserve",
        "issued_amount": "180000",
        "issue_month": "3",
        "issue_year": "2021"
      }
    ]
  },
  "sample_output": [
    {
      "card_name": "Chase Freedom Flex",
      "difference": "15000"
    },
    {
      "card_name": "Chase Sapphire Reserve",
      "difference": "10000"
    }
  ],
  "reference_sql": "SELECT \n  card_name,\n  MAX(issued_amount) - MIN(issued_amount) AS difference\nFROM monthly_cards_issued\nGROUP BY card_name\nORDER BY difference DESC, card_name ASC;",
  "tags": [
    "date-manipulation",
    "easy",
    "jpmorgan"
  ],
