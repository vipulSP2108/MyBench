  "title": "Data Science Skills",
  "difficulty": "Easy",
  "company": "LinkedIn",
  "premium": false,
  "question": "LinkedIn technical recruiters are sourcing candidates for a specialized Full-Stack Data Engineer role.\n\nTo be qualified for this specific role, a candidate must possess **all three** of the following core skills:\n• `Python`\n• `Tableau`\n• `PostgreSQL`\n\nWrite a query to find the `candidate_id` of every candidate who possesses all three required skills. Sort the results by `candidate_id` in ascending order.",
  "notes": [
    "There are no duplicates in the candidates table.",
    "Candidate 123 is displayed because they have Python, Tableau, and PostgreSQL skills. 345 isn't included in the output because they're missing one of the required skills: PostgreSQL."
  ],
  "tables": [
    {
      "table_name": "candidates",
      "columns": [
        {
          "column_name": "candidate_id",
          "data_type": "INT"
        },
        {
          "column_name": "skill",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "candidates": [
      {
        "candidate_id": "123",
        "skill": "Python"
      },
      {
        "candidate_id": "123",
        "skill": "Tableau"
      },
      {
        "candidate_id": "123",
        "skill": "PostgreSQL"
      },
      {
        "candidate_id": "234",
        "skill": "R"
      },
      {
        "candidate_id": "234",
        "skill": "PowerBI"
      },
      {
        "candidate_id": "234",
        "skill": "SQL Server"
      },
      {
        "candidate_id": "345",
        "skill": "Python"
      },
      {
        "candidate_id": "345",
        "skill": "Tableau"
      }
    ]
  },
  "sample_output": [
    {
      "candidate_id": 123
    }
  ],
  "reference_sql": "SELECT candidate_id\nFROM candidates\nWHERE skill IN ('Python', 'Tableau', 'PostgreSQL')\nGROUP BY candidate_id\nHAVING COUNT(DISTINCT skill) = 3\nORDER BY candidate_id;",
