{
  "question_id": "q_056_off_topic_maps_ugc",
  "slug": "off-topic-maps-ugc",
  "title": "Google Maps Flagged UGC",
  "difficulty": "Medium",
  "company": "Google",
  "premium": true,
  "question": "Google Maps Trust & Safety moderators review User Generated Content (UGC) such as photos, reviews, and questions posted to local business profiles.\n\nWhen content violates community guidelines, moderators tag it as `'off-topic'`.\n\nWrite a query to identify which place category (e.g. `'Restaurant'`, `'Hotel'`, `'Museum'`) received the highest count of off-topic UGC uploads. If several categories tie for the highest count, return all of them. Output `place_category` and the count of off-topic uploads as `off_topic_count`, sorted by `place_category`.",
  "notes": [],
  "tables": [
    {
      "table_name": "place_info",
      "columns": [
        {
          "column_name": "place_id",
          "data_type": "INT"
        },
        {
          "column_name": "place_name",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "place_category",
          "data_type": "VARCHAR(255)"
        }
      ]
    },
    {
      "table_name": "maps_ugc_review",
      "columns": [
        {
          "column_name": "content_id",
          "data_type": "INT"
        },
        {
          "column_name": "place_id",
          "data_type": "INT"
        },
        {
          "column_name": "content_tag",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "place_info": [
      {
        "place_id": 1,
        "place_name": "Baar Baar",
        "place_category": "Restaurant"
      },
      {
        "place_id": 2,
        "place_name": "Rubirosa",
        "place_category": "Restaurant"
      },
      {
        "place_id": 3,
        "place_name": "Mr. Purple",
        "place_category": "Bar"
      },
      {
        "place_id": 4,
        "place_name": "La Caverna",
        "place_category": "Bar"
      }
    ],
    "maps_ugc_review": [
      {
        "content_id": 101,
        "place_id": 1,
        "content_tag": "Off-topic"
      },
      {
        "content_id": 110,
        "place_id": 2,
        "content_tag": "Misinformation"
      },
      {
        "content_id": 153,
        "place_id": 2,
        "content_tag": "Off-topic"
      },
      {
        "content_id": 176,
        "place_id": 3,
        "content_tag": "Harassment"
      },
      {
        "content_id": 190,
        "place_id": 3,
        "content_tag": "Off-topic"
      },
      {
        "content_id": 195,
        "place_id": 4,
        "content_tag": "Off-topic"
      }
    ]
  },
  "sample_output": [
    {
      "place_category": "Bar",
      "off_topic_count": 2
    },
    {
      "place_category": "Restaurant",
      "off_topic_count": 2
    }
  ],
  "reference_sql": "WITH counts AS (\n  SELECT p.place_category, COUNT(u.content_id) AS off_topic_count\n  FROM place_info p\n  JOIN maps_ugc_review u ON p.place_id = u.place_id\n  WHERE LOWER(u.content_tag) = 'off-topic'\n  GROUP BY p.place_category\n)\nSELECT place_category, off_topic_count\nFROM counts\nWHERE off_topic_count = (SELECT MAX(off_topic_count) FROM counts)\nORDER BY place_category;",
  "tags": [
    "aggregation",
    "cte",
    "ecommerce",
    "google",
    "hr",
    "join",
    "medium"
  ],
