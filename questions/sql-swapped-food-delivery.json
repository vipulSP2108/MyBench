{
  "question_id": "q_049_sql_swapped_food_delivery",
  "slug": "sql-swapped-food-delivery",
  "title": "Swapped Food Delivery",
  "difficulty": "Medium",
  "company": "Zomato",
  "premium": false,
  "question": "Zomato dispatch systems experienced an order sequencing bug that swapped every pair of consecutive delivery orders.\n\nSpecifically, Order 1 was swapped with Order 2, Order 3 was swapped with Order 4, and so on. If the total number of orders is odd, the final order ID remains unchanged.\n\nWrite a query to correct the order IDs by swapping every consecutive pair of orders, while keeping the last odd order unchanged. Output the corrected `order_id` and the associated `item`, sorted by `order_id` in ascending order.",
  "notes": [
    "Here's a sample of the initial incorrect data:",
    "The corrected data should look like this:",
    "Order ID 1 is now associated with Pizza and Order ID 2 is paired with Chow Mein. This adjustment ensures that each order is correctly aligned with its respective item, addressing the initial swapping error.",
    "Order ID 7 remains unchanged and is still associated with Tandoori Chicken. This preserves the order sequence ensuring that the last odd order ID remains unaltered."
  ],
  "tables": [
    {
      "table_name": "orders",
      "columns": [
        {
          "column_name": "order_id",
          "data_type": "INT"
        },
        {
          "column_name": "item",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "orders": [
      {
        "order_id": "1",
        "item": "Chow Mein"
      },
      {
        "order_id": "2",
        "item": "Pizza"
      },
      {
        "order_id": "3",
        "item": "Pad Thai"
      },
      {
        "order_id": "4",
        "item": "Butter Chicken"
      },
      {
        "order_id": "5",
        "item": "Eggrolls"
      },
      {
        "order_id": "6",
        "item": "Burger"
      },
      {
        "order_id": "7",
        "item": "Tandoori Chicken"
      }
    ]
  },
  "sample_output": [
    {
      "corrected_order_id": "1",
      "item": "Pizza"
    },
    {
      "corrected_order_id": "2",
      "item": "Chow Mein"
    },
    {
      "corrected_order_id": "3",
      "item": "Butter Chicken"
    },
    {
      "corrected_order_id": "4",
      "item": "Pad Thai"
    },
    {
      "corrected_order_id": "5",
      "item": "Burger"
    },
    {
      "corrected_order_id": "6",
      "item": "Eggrolls"
    },
    {
      "corrected_order_id": "7",
      "item": "Tandoori Chicken"
    }
  ],
  "reference_sql": "SELECT \n  order_id,\n  CASE \n    WHEN order_id % 2 = 1 AND order_id = (SELECT MAX(order_id) FROM orders) THEN item\n    WHEN order_id % 2 = 1 THEN LEAD(item, 1) OVER (ORDER BY order_id)\n    ELSE LAG(item, 1) OVER (ORDER BY order_id)\n  END AS item\nFROM orders\nORDER BY order_id;",
  "tags": [
    "aggregation",
    "ecommerce",
    "lead-lag",
    "medium",
    "transportation",
    "window-function",
    "zomato"
  ],
