{
  "question_id": "q_080_marketing_touch_streak",
  "slug": "marketing-touch-streak",
  "title": "Marketing Touch Streak",
  "difficulty": "Hard",
  "company": "Snowflake",
  "premium": false,
  "question": "Snowflake enterprise marketing tracks prospective enterprise accounts through sequential touchpoints (emails, webinars, product demos).\n\nA sales lead is **highly engaged** if they had a marketing touch in at least **three consecutive calendar weeks**. Weeks start on Monday, and several touches in the same week count as one week.\n\nWrite a query to return the email addresses of all highly engaged leads. Return unique emails sorted alphabetically.",
  "notes": [
    "Contact 1 had touches in the weeks of Apr 11, Apr 18 and Apr 25 (three consecutive weeks), so andy.markus@att.net qualifies.",
    "Contact 2 had all of their touches within the single week of Apr 18, so they do not qualify."
  ],
  "tables": [
    {
      "table_name": "marketing_touches",
      "columns": [
        {
          "column_name": "event_id",
          "data_type": "INT"
        },
        {
          "column_name": "contact_id",
          "data_type": "INT"
        },
        {
          "column_name": "event_type",
          "data_type": "VARCHAR(50)"
        },
        {
          "column_name": "event_date",
          "data_type": "DATE"
        }
      ]
    },
    {
      "table_name": "crm_contacts",
      "columns": [
        {
          "column_name": "contact_id",
          "data_type": "INT"
        },
        {
          "column_name": "email",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "marketing_touches": [
      {
        "event_id": "1",
