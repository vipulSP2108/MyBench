{
  "question_id": "q_021_total_drugs_sales",
  "slug": "total-drugs-sales",
  "title": "Pharmacy Analytics (Part 3)",
  "difficulty": "Easy",
  "company": "CVS Health",
  "premium": false,
  "question": "CVS Health executive leadership reviews annual sales volume across commercial pharmaceutical manufacturers.\n\nWrite a query to calculate the total aggregate drug sales generated by each manufacturer.\n\nFormat the sales numbers rounded to the nearest million dollars as `$X million` (for example: `'$4 million'`). Output the `manufacturer` and the formatted sales figure as `sales_mil`, ordered from highest sales to lowest sales.",
  "notes": [
    "Biogen: $2,041,758.41 + $500,101.61 + $1,084,258.00 = $3,626,118.02, which rounds to $4 million.",
    "Eli Lilly: $293,452.54 rounds to $0 million."
  ],
  "tables": [
    {
      "table_name": "pharmacy_sales",
      "columns": [
        {
          "column_name": "product_id",
          "data_type": "INT"
        },
        {
          "column_name": "units_sold",
          "data_type": "INT"
        },
        {
          "column_name": "total_sales",
          "data_type": "DECIMAL(10,2)"
        },
        {
          "column_name": "cogs",
          "data_type": "DECIMAL(10,2)"
        },
        {
          "column_name": "manufacturer",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "drug",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "pharmacy_sales": [
      {
        "product_id": "94",
        "units_sold": "132362",
        "total_sales": "2041758.41",
        "cogs": "1373721.70",
        "manufacturer": "Biogen",
        "drug": "UP and UP"
      },
      {
        "product_id": "9",
        "units_sold": "37410",
        "total_sales": "293452.54",
        "cogs": "208876.01",
        "manufacturer": "Eli Lilly",
        "drug": "Zyprexa"
      },
      {
        "product_id": "61",
        "units_sold": "77023",
        "total_sales": "500101.61",
        "cogs": "419174.97",
        "manufacturer": "Biogen",
        "drug": "Varicose Relief"
      },
      {
        "product_id": "136",
        "units_sold": "144814",
        "total_sales": "1084258.00",
        "cogs": "1006447.73",
        "manufacturer": "Biogen",
        "drug": "Burkhart"
      }
    ]
  },
  "sample_output": [
    {
      "manufacturer": "Biogen",
      "sales_mil": "$4 million"
    },
    {
      "manufacturer": "Eli Lilly",
      "sales_mil": "$0 million"
    }
  ],
  "reference_sql": "SELECT\n  manufacturer,\n  CONCAT('$', CAST(ROUND(SUM(total_sales) / 1000000, 0) AS SIGNED), ' million') AS sales_mil\nFROM pharmacy_sales\nGROUP BY manufacturer\nORDER BY SUM(total_sales) DESC, manufacturer;",
