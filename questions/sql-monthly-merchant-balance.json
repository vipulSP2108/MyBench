{
  "question_id": "q_090_sql_monthly_merchant_balance",
  "slug": "sql-monthly-merchant-balance",
  "title": "Monthly Merchant Balance",
  "difficulty": "Hard",
  "company": "Visa",
  "premium": true,
  "question": "Visa payment processing networks reconcile monthly net settlement balances for commercial merchants.\n\nIn the merchant transaction ledger:\n• Incoming customer payments (`type = 'deposit'`) add funds to the balance.\n• Merchant fees or refunds (`type = 'withdrawal'`) subtract funds from the balance.\n\nWrite a query to calculate the net monthly transaction balance for each month. Output `transaction_month` (formatted `'YYYY-MM'`) and `balance` (deposits minus withdrawals), ordered by month.",
  "notes": [],
  "tables": [
    {
      "table_name": "transactions",
      "columns": [
        {
          "column_name": "transaction_id",
          "data_type": "INT"
        },
        {
          "column_name": "type",
          "data_type": "VARCHAR(50)"
        },
        {
          "column_name": "amount",
          "data_type": "DECIMAL(10,2)"
        },
        {
          "column_name": "transaction_date",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
    "transactions": [
      {
        "transaction_id": 19153,
        "type": "deposit",
        "amount": "65.90",
        "transaction_date": "07/10/2022 10:00:00"
      },
      {
        "transaction_id": 53151,
        "type": "deposit",
        "amount": "178.55",
        "transaction_date": "07/08/2022 10:00:00"
      },
      {
        "transaction_id": 29776,
        "type": "withdrawal",
        "amount": "25.90",
        "transaction_date": "07/08/2022 10:00:00"
      },
      {
        "transaction_id": 16461,
        "type": "withdrawal",
        "amount": "45.99",
        "transaction_date": "07/08/2022 10:00:00"
      },
      {
        "transaction_id": 77134,
        "type": "deposit",
        "amount": "32.60",
        "transaction_date": "07/10/2022 10:00:00"
      }
    ]
  },
  "sample_output": [
    {
      "transaction_month": "2022-07",
      "balance": 205.16
    }
  ],
  "reference_sql": "SELECT\n  DATE_FORMAT(transaction_date, '%Y-%m') AS transaction_month,\n  SUM(CASE WHEN type = 'deposit' THEN amount ELSE -amount END) AS balance\nFROM transactions\nGROUP BY DATE_FORMAT(transaction_date, '%Y-%m')\nORDER BY transaction_month;",
  "tags": [
    "aggregation",
    "date-manipulation",
    "finance",
    "hard",
    "visa"
  ],
