{
  "question_id": "q_005_laptop_mobile_viewership",
  "slug": "laptop-mobile-viewership",
  "title": "Laptop vs. Mobile Viewership",
  "difficulty": "Easy",
  "company": "NY Times",
  "premium": false,
  "question": "The New York Times digital audience team tracks readership distribution across device platforms.\n\nDevice categories are tracked as follows:\n• **Laptop viewership**: Views occurring on `'laptop'` devices.\n• **Mobile viewership**: The combined sum of views occurring on `'tablet'` and `'phone'` devices.\n\nWrite a query to calculate total viewership across both segments. Output the total laptop viewership as `laptop_views` and total mobile viewership as `mobile_views`.",
  "notes": [
    "Based on the example input, there are a total of 2 laptop views and 3 mobile views."
  ],
  "tables": [
    {
      "table_name": "viewership",
      "columns": [
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "device_type",
          "data_type": "VARCHAR(50)"
        },
        {
          "column_name": "view_time",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
    "viewership": [
      {
        "user_id": "123",
        "device_type": "tablet",
        "view_time": "01/02/2022 00:00:00"
      },
      {
        "user_id": "125",
        "device_type": "laptop",
        "view_time": "01/07/2022 00:00:00"
      },
      {
        "user_id": "128",
        "device_type": "laptop",
        "view_time": "02/09/2022 00:00:00"
      },
      {
        "user_id": "129",
        "device_type": "phone",
        "view_time": "02/09/2022 00:00:00"
      },
      {
        "user_id": "145",
        "device_type": "tablet",
        "view_time": "02/24/2022 00:00:00"
      }
    ]
  },
  "sample_output": [
    {
      "laptop_views": "2",
      "mobile_views": "3"
    }
  ],
  "reference_sql": "SELECT \n  SUM(CASE WHEN device_type = 'laptop' THEN 1 ELSE 0 END) AS laptop_views,\n  SUM(CASE WHEN device_type IN ('tablet', 'phone') THEN 1 ELSE 0 END) AS mobile_views\nFROM viewership;",
  "tags": [
    "aggregation",
    "date-manipulation",
    "easy",
    "ny times"
  ],
