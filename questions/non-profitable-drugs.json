        "units_sold": "222331",
        "total_sales": "2753546.00",
        "cogs": "2974975.36",
        "manufacturer": "AbbVie",
        "drug": "Lamivudine and Zidovudine"
      },
      {
        "product_id": "50",
        "units_sold": "90484",
        "total_sales": "2521023.73",
        "cogs": "2742445.90",
        "manufacturer": "Eli Lilly",
        "drug": "Dermasorb TA Complete Kit"
      },
      {
        "product_id": "98",
        "units_sold": "110746",
        "total_sales": "813188.82",
        "cogs": "140422.87",
        "manufacturer": "Biogen",
        "drug": "Medi-Chord"
      }
    ]
  },
  "sample_output": [
    {
      "manufacturer": "Biogen",
      "drug_count": 1,
      "total_loss": 297324.73
    },
    {
      "manufacturer": "AbbVie",
      "drug_count": 1,
      "total_loss": 221429.36
    },
    {
      "manufacturer": "Eli Lilly",
      "drug_count": 1,
      "total_loss": 221422.17
    }
  ],
  "reference_sql": "SELECT \n  manufacturer,\n  COUNT(drug) AS drug_count,\n  SUM(cogs - total_sales) AS total_loss\nFROM pharmacy_sales\nWHERE total_sales < cogs\nGROUP BY manufacturer\nORDER BY total_loss DESC, manufacturer ASC;",
