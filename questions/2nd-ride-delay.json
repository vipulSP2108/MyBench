{
  "question_id": "q_054_2nd_ride_delay",
  "slug": "2nd-ride-delay",
  "title": "2nd Ride Delay",
  "difficulty": "Medium",
  "company": "Uber",
  "premium": true,
  "question": "At Uber, the rider growth team wants to analyze how quickly new riders transition from sign-up to regular usage.\n\nSome users download the app, create an account, and request a trip on that exact same day. These riders are considered **same-day riders** (users whose registration date matches their very first ride date).\n\nThe team wants to measure onboarding momentum specifically for these same-day riders. Write a query to calculate the average delay (in days) between their initial account registration date and the date of their **second ride**.\n\nRound the resulting average delay to 2 decimal places.",
  "notes": [],
  "tables": [
    {
      "table_name": "users",
      "columns": [
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "registration_date",
          "data_type": "DATE"
        }
      ]
    },
    {
      "table_name": "rides",
      "columns": [
        {
          "column_name": "ride_id",
          "data_type": "INT"
        },
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "ride_date",
          "data_type": "DATE"
        }
      ]
    }
  ],
  "sample_data": {
    "users": [
      {
        "user_id": 1,
        "registration_date": "08/15/2022"
      },
      {
        "user_id": 2,
        "registration_date": "08/21/2022"
      }
    ],
    "rides": [
      {
        "ride_id": 1,
        "user_id": 1,
        "ride_date": "08/15/2022"
      },
      {
        "ride_id": 2,
        "user_id": 1,
        "ride_date": "08/16/2022"
      },
      {
        "ride_id": 3,
        "user_id": 2,
        "ride_date": "09/20/2022"
      },
      {
        "ride_id": 4,
        "user_id": 2,
        "ride_date": "09/23/2022"
      }
    ]
  },
  "sample_output": [
    {
      "avg_delay": 1.0
    }
  ],
  "reference_sql": "WITH ranked_rides AS (\n  SELECT \n    user_id, \n    ride_date,\n    ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY ride_date) AS rn\n  FROM rides\n),\nfirst_rides AS (\n  SELECT user_id, ride_date AS first_ride_date\n  FROM ranked_rides\n  WHERE rn = 1\n),\nsecond_rides AS (\n  SELECT user_id, ride_date AS second_ride_date\n  FROM ranked_rides\n  WHERE rn = 2\n)\nSELECT \n  ROUND(AVG(DATEDIFF(s.second_ride_date, u.registration_date)), 2) AS avg_delay\nFROM users u\nJOIN first_rides f ON u.user_id = f.user_id AND u.registration_date = f.first_ride_date\nJOIN second_rides s ON u.user_id = s.user_id;",
  "tags": [
    "aggregation",
    "date-manipulation",
    "healthcare",
    "math",
    "medium",
    "transportation",
    "uber"
  ],
