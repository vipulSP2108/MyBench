  "title": "Page With No Likes",
  "difficulty": "Easy",
  "company": "Facebook",
  "premium": false,
  "question": "Facebook community operations team is reviewing newly created business pages to identify inactive or unengaged pages.\n\nA page has zero engagement if no user has ever clicked 'Like' on it (it has no recorded rows in the `page_likes` table).\n\nWrite a query to find the `page_id` of all Facebook pages that have never received a like. Output the page IDs sorted in ascending order.",
  "notes": [],
  "tables": [
    {
      "table_name": "pages",
      "columns": [
        {
          "column_name": "page_id",
          "data_type": "INT"
        },
        {
          "column_name": "page_name",
          "data_type": "VARCHAR(255)"
        }
      ]
    },
    {
      "table_name": "page_likes",
      "columns": [
        {
          "column_name": "user_id",
          "data_type": "INT"
        },
        {
          "column_name": "page_id",
          "data_type": "INT"
        },
        {
          "column_name": "liked_date",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
    "pages": [
      {
        "page_id": "20001",
        "page_name": "SQL Solutions"
      },
      {
        "page_id": "20045",
        "page_name": "Brain Exercises"
      },
      {
        "page_id": "20701",
        "page_name": "Tips for Data Analysts"
      }
    ],
    "page_likes": [
