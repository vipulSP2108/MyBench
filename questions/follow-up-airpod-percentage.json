{
  "question_id": "q_100_follow_up_airpod_percentage",
  "slug": "follow-up-airpod-percentage",
  "title": "Follow-Up Airpod Percentage",
  "difficulty": "Hard",
  "company": "Apple",
  "premium": true,
  "question": "Apple customer experience analysts want to evaluate cross-selling effectiveness between iPhone and AirPods.\n\nSpecifically, the team wants to know: what percentage of customers who purchased an **iPhone** went on to buy **AirPods** in a subsequent transaction?\n\nWrite a query to calculate this percentage. Round the final value to the nearest whole integer (e.g. 25).",
  "notes": [],
  "tables": [
    {
      "table_name": "transactions",
      "columns": [
        {
          "column_name": "transaction_id",
          "data_type": "INT"
        },
        {
          "column_name": "customer_id",
          "data_type": "INT"
        },
        {
          "column_name": "product_name",
          "data_type": "VARCHAR(255)"
        },
        {
          "column_name": "transaction_timestamp",
          "data_type": "DATETIME"
        }
      ]
    }
  ],
  "sample_data": {
    "transactions": [
      {
        "transaction_id": 1,
        "customer_id": 101,
        "product_name": "iPhone",
        "transaction_timestamp": "08/08/2022 00:00:00"
      },
      {
        "transaction_id": 2,
        "customer_id": 101,
        "product_name": "AirPods",
        "transaction_timestamp": "08/08/2022 00:00:00"
      },
      {
        "transaction_id": 5,
        "customer_id": 301,
        "product_name": "iPhone",
        "transaction_timestamp": "09/05/2022 00:00:00"
      },
      {
        "transaction_id": 6,
        "customer_id": 301,
        "product_name": "iPad",
        "transaction_timestamp": "09/06/2022 00:00:00"
      },
      {
        "transaction_id": 7,
        "customer_id": 301,
        "product_name": "AirPods",
        "transaction_timestamp": "09/07/2022 00:00:00"
      }
    ]
  },
  "sample_output": [
    {
      "follow_up_percentage": 50
    }
  ],
  "reference_sql": "WITH iphone AS (\n  SELECT customer_id, MIN(transaction_timestamp) AS first_iphone\n  FROM transactions\n  WHERE product_name = 'iPhone'\n  GROUP BY customer_id\n),\nfollowed AS (\n  SELECT DISTINCT i.customer_id\n  FROM iphone i\n  JOIN transactions t\n    ON t.customer_id = i.customer_id\n   AND t.product_name = 'AirPods'\n   AND t.transaction_timestamp > i.first_iphone\n)\nSELECT ROUND(100.0 * (SELECT COUNT(*) FROM followed) / NULLIF((SELECT COUNT(*) FROM iphone), 0), 0) AS follow_up_percentage;",
  "tags": [
    "aggregation",
    "apple",
    "cte",
    "ecommerce",
    "finance",
    "hard",
    "lead-lag",
    "math",
    "window-function"
  ],
