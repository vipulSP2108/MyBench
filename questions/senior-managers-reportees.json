{
  "question_id": "q_086_senior_managers_reportees",
  "slug": "senior-managers-reportees",
  "title": "Senior Managers",
  "difficulty": "Hard",
  "company": "Google",
  "premium": false,
  "question": "Google People Analytics audits the organizational hierarchy to find managers who oversee larger teams.\n\nEach row of `employees` is one employee (`emp_id`) together with the id and name of their direct manager (`manager_id`, `manager_name`).\n\nA manager is a **Senior Manager** if they have **at least 3 direct reports**.\n\nWrite a query to output the `manager_name` and the number of direct reports (`direct_reports`) for every senior manager, ordered by `direct_reports` in descending order, then by `manager_name`.",
  "notes": [
    "Rick (id 1001) manages employees 101, 103 and 104, so he has 3 direct reports. John has 2 and Duyen has 1, so neither is a senior manager."
  ],
  "tables": [
    {
      "table_name": "employees",
      "columns": [
        {
          "column_name": "emp_id",
          "data_type": "INT"
        },
        {
          "column_name": "manager_id",
          "data_type": "INT"
        },
        {
          "column_name": "manager_name",
          "data_type": "VARCHAR(255)"
        }
      ]
    }
  ],
  "sample_data": {
    "employees": [
      {
        "emp_id": 1,
        "manager_id": 101,
        "manager_name": "Duyen"
      },
      {
        "emp_id": 101,
        "manager_id": 1001,
        "manager_name": "Rick"
      },
      {
        "emp_id": 103,
        "manager_id": 1001,
        "manager_name": "Rick"
      },
      {
        "emp_id": 104,
        "manager_id": 1001,
        "manager_name": "Rick"
      },
      {
        "emp_id": 1001,
        "manager_id": 1008,
        "manager_name": "John"
      },
      {
        "emp_id": 1002,
        "manager_id": 1008,
        "manager_name": "John"
      }
    ]
  },
  "sample_output": [
    {
      "manager_name": "Rick",
      "direct_reports": 3
    }
  ],
  "reference_sql": "SELECT manager_name, COUNT(DISTINCT emp_id) AS direct_reports\nFROM employees\nWHERE manager_id IS NOT NULL\nGROUP BY manager_id, manager_name\nHAVING COUNT(DISTINCT emp_id) >= 3\nORDER BY direct_reports DESC, manager_name;",
  "tags": [
    "aggregation",
    "cte",
    "google",
    "hard",
    "hr",
    "join",
    "self-join"
  ],
