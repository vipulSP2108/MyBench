{
  "question_id": "q_098_average_vacant_days",
  "slug": "average-vacant-days",
  "title": "Average Vacant Days",
  "difficulty": "Hard",
  "company": "Airbnb",
  "premium": true,
  "question": "Airbnb market managers analyze property utilization across different cities to help hosts optimize pricing.\n\nA property's **vacant days** in a year (assuming a standard 365-day year) is calculated as:\n• Vacant Days = 365 - Total Days Booked\n\nWrite a query to calculate the average number of vacant days per listing for each city in the year 2021. Round the average vacant days to 1 decimal place, and sort by city name.",
  "notes": [],
  "tables": [
    {
      "table_name": "bookings",
      "columns": [
        {
          "column_name": "listing_id",
          "data_type": "INT"
        },
        {
          "column_name": "checkin_date",
          "data_type": "DATE"
        },
        {
          "column_name": "checkout_date",
          "data_type": "DATE"
        }
      ]
    },
    {
      "table_name": "listings",
      "columns": [
        {
          "column_name": "listing_id",
          "data_type": "INT"
        },
        {
          "column_name": "is_active",
          "data_type": "INT"
        }
      ]
    }
  ],
  "sample_data": {
    "bookings": [
      {
        "listing_id": 1,
        "checkin_date": "08/17/2021 00:00:00",
        "checkout_date": "08/19/2021 00:00:00"
      },
      {
        "listing_id": 1,
        "checkin_date": "08/19/2021 00:00:00",
        "checkout_date": "08/25/2021 00:00:00"
      },
      {
        "listing_id": 2,
        "checkin_date": "08/19/2021 00:00:00",
        "checkout_date": "09/22/2021 00:00:00"
      },
      {
        "listing_id": 3,
        "checkin_date": "12/23/2021 00:00:00",
        "checkout_date": "01/05/2022 00:00:00"
      }
    ],
    "listings": [
      {
        "listing_id": 1,
        "is_active": 1
      },
      {
        "listing_id": 2,
        "is_active": 0
      },
      {
        "listing_id": 3,
        "is_active": 1
      }
    ]
  },
  "sample_output": [
    {
      "avg_vacant_days": 357
    }
  ],
  "reference_sql": "SELECT \n  ROUND(AVG(365 - IFNULL(DATEDIFF(b.checkout_date, b.checkin_date), 0)), 1) AS avg_vacant_days\nFROM listings l\nLEFT JOIN bookings b ON l.listing_id = b.listing_id\nWHERE l.is_active = 1;",
  "tags": [
    "aggregation",
    "airbnb",
    "date-manipulation",
    "hard",
    "math"
  ],
